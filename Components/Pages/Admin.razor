@page "/admin"
@inject IAdminAuthService AuthService
@inject IPersonService PersonService
@rendermode InteractiveServer

<PageTitle>Portal Administrativo BNC - Amigo Secreto 2026</PageTitle>

<div class="container-fluid px-lg-5 py-4">
    @if (!AuthService.IsAuthenticated)
    {
        <!-- LOGIN SCREEN -->
        <div class="row justify-content-center py-5">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="p-4 p-md-5 text-center bg-white border-bottom position-relative" style="border-top: 5px solid var(--bnc-orange) !important;">
                        <div class="mb-3">
                            <BncLogo Height="46" ShowSubtitle="true" />
                        </div>
                        <h4 class="fw-bold mb-1" style="color: var(--bnc-navy-dark);">Portal Administrativo</h4>
                        <p class="text-muted small mb-0">Gestión de Participantes • Amigo Secreto 2026</p>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">
                        @if (!string.IsNullOrEmpty(loginError))
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2">
                                <SvgIcon Name="alert" Size="16" Class="text-danger" />
                                <div>@loginError</div>
                            </div>
                        }

                        <form @onsubmit="HandleLogin">
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Usuario Administrador</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0">
                                        <SvgIcon Name="user" Size="16" Class="text-muted" />
                                    </span>
                                    <input type="text" class="form-control border-start-0" @bind="inputUser" placeholder="admin" required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold text-secondary small">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0">
                                        <SvgIcon Name="key" Size="16" Class="text-muted" />
                                    </span>
                                    <input type="@(showPassword ? "text" : "password")" class="form-control border-start-0 border-end-0" @bind="inputPassword" placeholder="bnc2026" required />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => showPassword = !showPassword" title="Mostrar/ocultar contraseña">
                                        <SvgIcon Name="@(showPassword ? "eye-off" : "eye")" Size="16" />
                                    </button>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-bnc-orange w-100 py-2 fs-6 d-flex align-items-center justify-content-center gap-2">
                                <SvgIcon Name="lock" Size="18" />
                                <span>Iniciar Sesión BNC</span>
                            </button>
                        </form>

                        <!-- Quick Demo Credentials Helper -->
                        <div class="mt-4 pt-3 border-top text-center">
                            <small class="text-muted d-block mb-2">Credenciales oficiales de acceso:</small>
                            <div class="d-inline-flex gap-2 align-items-center bg-light p-2 rounded-3 border small">
                                <span>Usuario: <strong style="color: var(--bnc-navy);">admin</strong></span>
                                <span class="text-muted">|</span>
                                <span>Clave: <strong style="color: var(--bnc-orange);">bnc2026</strong></span>
                            </div>
                            <div class="mt-2">
                                <button type="button" class="btn btn-link btn-sm text-decoration-none fw-semibold" style="color: var(--bnc-navy);" @onclick="FillDemoCredentials">
                                    Autocompletar credenciales
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ADMIN DASHBOARD -->
        <!-- Header Banner with BNC Corporate Styling -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge px-3 py-2 rounded-pill text-white" style="background-color: var(--bnc-navy);">
                        BNC Administración
                    </span>
                    <h2 class="fw-bold mb-0" style="color: var(--bnc-navy-dark);">Gestión de Participantes</h2>
                </div>
                <p class="text-muted small mb-0 mt-1">
                    Crea participantes, define sus preferencias, gustos, cosas que prefieren evitar y alergias para el Amigo Secreto BNC.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-bnc-orange d-flex align-items-center gap-2" @onclick="OpenCreateModal">
                    <SvgIcon Name="plus" Size="18" />
                    <span>Nuevo Participante</span>
                </button>
                <button type="button" class="btn btn-outline-danger d-flex align-items-center gap-2" @onclick="HandleLogout">
                    <SvgIcon Name="logout" Size="16" />
                    <span>Cerrar Sesión</span>
                </button>
            </div>
        </div>

        <!-- Notification Toast -->
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="toast-floating">
                <SvgIcon Name="check-circle" Size="20" Class="text-warning" />
                <span>@statusMessage</span>
            </div>
        }

        <!-- Stats Overview Cards -->
        <div class="row g-2 g-sm-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="admin-stat-card p-2 p-sm-3">
                    <div class="admin-icon-box d-none d-sm-flex" style="background-color: #e0f2fe; color: var(--bnc-navy);">
                        <SvgIcon Name="users" Size="22" />
                    </div>
                    <div>
                        <div class="text-muted small">Total Registrados</div>
                        <div class="fs-4 fw-bold" style="color: var(--bnc-navy-dark);">@people.Count</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="admin-stat-card p-2 p-sm-3">
                    <div class="admin-icon-box d-none d-sm-flex" style="background-color: #dcfce7; color: #15803d;">
                        <SvgIcon Name="gift" Size="22" />
                    </div>
                    <div>
                        <div class="text-muted small">Con Gustos</div>
                        <div class="fs-4 fw-bold text-success">@people.Count(p => p.HasCustomLikes)</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="admin-stat-card p-2 p-sm-3">
                    <div class="admin-icon-box d-none d-sm-flex" style="background-color: #ffedd5; color: var(--bnc-orange);">
                        <SvgIcon Name="alert" Size="22" />
                    </div>
                    <div>
                        <div class="text-muted small">Con Alergias</div>
                        <div class="fs-4 fw-bold" style="color: var(--bnc-orange);">@people.Count(p => p.AllergiesList.Any())</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="admin-stat-card p-2 p-sm-3">
                    <div class="admin-icon-box d-none d-sm-flex" style="background-color: #f1f5f9; color: #475569;">
                        <SvgIcon Name="building" Size="22" />
                    </div>
                    <div>
                        <div class="text-muted small">Departamentos</div>
                        <div class="fs-4 fw-bold text-secondary">@departments.Count</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Table Section -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
            <!-- Filter & Search Toolbar -->
            <div class="p-3 bg-light border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 420px;">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <SvgIcon Name="search" Size="16" Class="text-muted" />
                        </span>
                        <input type="text" 
                               class="form-control border-start-0" 
                               placeholder="Filtrar participante por nombre o apellido..." 
                               @bind="tableSearch" 
                               @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(tableSearch))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => tableSearch = string.Empty">
                                <SvgIcon Name="dislike" Size="14" />
                            </button>
                        }
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="ResetSampleDataAsync" title="Restaura la lista demo inicial de participantes">
                        <SvgIcon Name="refresh" Size="14" />
                        <span>Restablecer muestra BNC</span>
                    </button>
                    <span class="badge py-2 px-3 rounded-pill text-white" style="background-color: var(--bnc-navy);">
                        @FilteredPeople.Count participantes
                    </span>
                </div>
            </div>

            <!-- Table with clean design -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4">Participante BNC</th>
                            <th>Departamento</th>
                            <th>Gustos (Wishlist)</th>
                            <th>Evitar (Disgustos)</th>
                            <th>Alergias</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredPeople.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No se encontraron participantes que coincidan con la búsqueda.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in FilteredPeople)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-circle" style="width: 42px; height: 42px; font-size: 0.95rem; background: linear-gradient(135deg, @(p.AvatarColor ?? "#002855"), var(--bnc-orange));">
                                                @p.Initials
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@p.FullName</div>
                                                <small class="text-muted">@(p.Email ?? "Sin correo registrado")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(p.Department ?? "BNC")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1" style="max-width: 250px;">
                                            @foreach (var like in p.LikesList.Take(2))
                                            {
                                                <div class="badge bg-success-subtle text-success text-truncate text-start p-1 fw-normal border border-success-subtle d-flex align-items-center gap-1">
                                                    <SvgIcon Name="check" Size="12" />
                                                    <span class="text-truncate">@like</span>
                                                </div>
                                            }
                                            @if (p.LikesList.Count > 2)
                                            {
                                                <small class="text-muted">+@(p.LikesList.Count - 2) más...</small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1" style="max-width: 250px;">
                                            @foreach (var dislike in p.DislikesList.Take(2))
                                            {
                                                <div class="badge bg-danger-subtle text-danger text-truncate text-start p-1 fw-normal border border-danger-subtle d-flex align-items-center gap-1">
                                                    <SvgIcon Name="dislike" Size="12" />
                                                    <span class="text-truncate">@dislike</span>
                                                </div>
                                            }
                                            @if (p.DislikesList.Count > 2)
                                            {
                                                <small class="text-muted">+@(p.DislikesList.Count - 2) más...</small>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (p.AllergiesList.Any())
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle p-2 d-inline-flex align-items-center gap-1">
                                                <SvgIcon Name="alert" Size="13" />
                                                <span>@p.AllergiesList.First()</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Ninguna</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" 
                                                    style="border-color: var(--bnc-navy); color: var(--bnc-navy);"
                                                    @onclick="() => OpenEditModal(p)" 
                                                    title="Editar participante">
                                                <SvgIcon Name="edit" Size="14" />
                                                <span>Editar</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center" 
                                                    @onclick="() => ConfirmDelete(p)" 
                                                    title="Eliminar participante">
                                                <SvgIcon Name="trash" Size="14" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Edit/Create Modal Component -->
        <PersonEditModal IsOpen="isEditModalOpen" 
                         PersonToEdit="personToEdit" 
                         Departments="departments" 
                         OnSaved="HandlePersonSaved" 
                         OnCancel="CloseEditModal" />

        <!-- Delete Confirmation Modal -->
        @if (personToDelete != null)
        {
            <div class="modal-backdrop-custom" @onclick="CancelDelete"></div>
            <div class="modal d-block" tabindex="-1" style="z-index: 1070;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                        <div class="modal-header border-bottom bg-danger-subtle text-danger px-4 py-3">
                            <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                                <SvgIcon Name="alert" Size="20" Class="text-danger" />
                                <span>Confirmar Eliminación</span>
                            </h5>
                            <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                        </div>
                        <div class="modal-body px-4 py-3">
                            <p class="mb-2">¿Estás seguro de que deseas eliminar a <strong>@personToDelete.FullName</strong> del Amigo Secreto BNC?</p>
                            <small class="text-muted">Se borrarán permanentemente sus preferencias de regalo, tallas y alertas registradas.</small>
                        </div>
                        <div class="modal-footer border-top bg-light px-4 py-3">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Cancelar</button>
                            <button type="button" class="btn btn-danger px-4 d-flex align-items-center gap-2" @onclick="ExecuteDeleteAsync">
                                <SvgIcon Name="trash" Size="16" />
                                <span>Sí, Eliminar</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private string inputUser = "";
    private string inputPassword = "";
    private string? loginError;
    private bool showPassword = false;

    private List<Person> people = new();
    private List<string> departments = new();
    private string tableSearch = "";

    private bool isEditModalOpen = false;
    private Person? personToEdit;
    private Person? personToDelete;
    private string? statusMessage;

    private List<Person> FilteredPeople => string.IsNullOrWhiteSpace(tableSearch)
        ? people
        : people.Where(p => 
            p.FullName.Contains(tableSearch, StringComparison.OrdinalIgnoreCase) ||
            (p.Department != null && p.Department.Contains(tableSearch, StringComparison.OrdinalIgnoreCase))
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthenticationStateChanged += HandleAuthStateChanged;
        if (AuthService.IsAuthenticated)
        {
            await LoadDataAsync();
        }
    }

    private void HandleAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLogin()
    {
        loginError = null;
        var success = AuthService.Login(inputUser, inputPassword);
        if (!success)
        {
            loginError = "Credenciales incorrectas. Verifica que el usuario sea 'admin' y la clave 'bnc2026'.";
        }
        else
        {
            _ = LoadDataAsync();
        }
    }

    private void FillDemoCredentials()
    {
        inputUser = "admin";
        inputPassword = "bnc2026";
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        inputUser = "";
        inputPassword = "";
    }

    private async Task LoadDataAsync()
    {
        people = await PersonService.GetAllAsync();
        departments = await PersonService.GetDepartmentsAsync();
    }

    private void OpenCreateModal()
    {
        personToEdit = null;
        isEditModalOpen = true;
    }

    private void OpenEditModal(Person p)
    {
        personToEdit = p;
        isEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        personToEdit = null;
    }

    private async Task HandlePersonSaved(Person saved)
    {
        CloseEditModal();
        await LoadDataAsync();
        ShowToast($"Participante '{saved.FullName}' guardado exitosamente");
    }

    private void ConfirmDelete(Person p)
    {
        personToDelete = p;
    }

    private void CancelDelete()
    {
        personToDelete = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (personToDelete != null)
        {
            var name = personToDelete.FullName;
            await PersonService.DeleteAsync(personToDelete.Id);
            personToDelete = null;
            await LoadDataAsync();
            ShowToast($"'{name}' ha sido eliminado correctamente");
        }
    }

    private async Task ResetSampleDataAsync()
    {
        await PersonService.ResetSampleDataAsync();
        await LoadDataAsync();
        ShowToast("Datos muestra de BNC restaurados exitosamente");
    }

    private void ShowToast(string message)
    {
        statusMessage = message;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3500);
            statusMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        AuthService.OnAuthenticationStateChanged -= HandleAuthStateChanged;
    }
}
