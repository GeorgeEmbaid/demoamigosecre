@page "/admin"
@implements IDisposable
@inject IAdminAuthService AuthService
@inject IPersonService PersonService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Portal Administrativo BNC - Amigo Secreto 2026</PageTitle>

<div class="container-fluid px-lg-5 py-4">
    @if (!AuthService.IsAuthenticated)
    {
        <!-- ADMIN LOGIN SCREEN -->
        <div class="row justify-content-center py-5">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <div class="p-4 p-md-5 text-center bg-white border-bottom position-relative" style="border-top: 5px solid var(--bnc-orange) !important;">
                        <div class="mb-3">
                            <BncLogo Height="46" ShowSubtitle="true" />
                        </div>
                        <h4 class="fw-bold mb-1" style="color: var(--bnc-navy-dark);">Portal Administrativo</h4>
                        <p class="text-muted small mb-0">Soporte y Gestión de Participantes • Amigo Secreto 2026</p>
                    </div>

                    <div class="card-body p-4 p-md-5 bg-white">
                        @if (!string.IsNullOrEmpty(loginError))
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2">
                                <SvgIcon Name="alert" Size="16" Class="text-danger" />
                                <div>@loginError</div>
                            </div>
                        }

                        <form @onsubmit="HandleLogin">
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Usuario Administrador</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0">
                                        <SvgIcon Name="user" Size="16" Class="text-muted" />
                                    </span>
                                    <input type="text" class="form-control border-start-0" @bind="inputUser" placeholder="admin" required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold text-secondary small">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0">
                                        <SvgIcon Name="key" Size="16" Class="text-muted" />
                                    </span>
                                    <input type="@(showPassword ? "text" : "password")" class="form-control border-start-0 border-end-0" @bind="inputPassword" placeholder="bnc2026" required />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => showPassword = !showPassword" title="Mostrar/ocultar contraseña">
                                        <SvgIcon Name="@(showPassword ? "eye-off" : "eye")" Size="16" />
                                    </button>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-bnc-orange w-100 py-2 fs-6 d-flex align-items-center justify-content-center gap-2">
                                <SvgIcon Name="lock" Size="18" />
                                <span>Iniciar Sesión Admin BNC</span>
                            </button>
                        </form>

                        <!-- Quick Demo Credentials Helper -->
                        <div class="mt-4 pt-3 border-top text-center">
                            <small class="text-muted d-block mb-2">Credenciales oficiales de administrador:</small>
                            <div class="d-inline-flex gap-2 align-items-center bg-light p-2 rounded-3 border small">
                                <span>Usuario: <strong style="color: var(--bnc-navy);">admin</strong></span>
                                <span class="text-muted">|</span>
                                <span>Clave: <strong style="color: var(--bnc-orange);">bnc2026</strong></span>
                            </div>
                            <div class="mt-2">
                                <button type="button" class="btn btn-link btn-sm text-decoration-none fw-semibold" style="color: var(--bnc-navy);" @onclick="FillDemoCredentials">
                                    Autocompletar credenciales
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ADMIN DASHBOARD -->
        <!-- Header Banner with BNC Corporate Styling -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge px-3 py-2 rounded-pill text-white" style="background-color: var(--bnc-navy);">
                        BNC Administración
                    </span>
                    <h2 class="fw-bold mb-0" style="color: var(--bnc-navy-dark);">Gestión y Soporte de Participantes</h2>
                </div>
                <p class="text-muted small mb-0 mt-1">
                    Apoya a los participantes editando sus usuarios/contraseñas de acceso, fotos, enlaces de regalo, gustos y alergias.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-bnc-orange d-flex align-items-center gap-2" @onclick="OpenCreateModal">
                    <SvgIcon Name="plus" Size="18" />
                    <span>Nuevo Participante</span>
                </button>
            </div>
        </div>

        <!-- Notification Toast -->
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="toast-floating">
                <SvgIcon Name="check-circle" Size="20" Class="text-warning" />
                <span>@statusMessage</span>
            </div>
        }

        <!-- Stats Overview Cards (4 focused metrics) -->
        <div class="row g-2 g-sm-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="admin-stat-card p-3">
                    <div class="admin-icon-box" style="background-color: #e0f2fe; color: var(--bnc-navy);">
                        <SvgIcon Name="users" Size="22" />
                    </div>
                    <div>
                        <div class="text-muted small">Participantes</div>
                        <div class="fs-4 fw-bold" style="color: var(--bnc-navy-dark);">@people.Count</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="admin-stat-card p-3">
                    <div class="admin-icon-box" style="background-color: #dcfce7; color: #15803d;">
                        <SvgIcon Name="gift" Size="22" />
                    </div>
                    <div>
                        <div class="text-muted small">Con Gustos</div>
                        <div class="fs-4 fw-bold text-success">@people.Count(p => p.HasCustomLikes)</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="admin-stat-card p-3">
                    <div class="admin-icon-box" style="background-color: #f3e8ff; color: #7e22ce;">
                        <SvgIcon Name="camera" Size="22" />
                    </div>
                    <div>
                        <div class="text-muted small">Con Foto / Regalo</div>
                        <div class="fs-4 fw-bold" style="color: #7e22ce;">@people.Count(p => p.HasProfilePhoto || p.HasGiftReference)</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="admin-stat-card p-3">
                    <div class="admin-icon-box" style="background-color: #ffedd5; color: var(--bnc-orange);">
                        <SvgIcon Name="alert" Size="22" />
                    </div>
                    <div>
                        <div class="text-muted small">Con Alergias</div>
                        <div class="fs-4 fw-bold" style="color: var(--bnc-orange);">@people.Count(p => p.AllergiesList.Any())</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Table Section -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
            <!-- Filter & Search Toolbar -->
            <div class="p-3 bg-light border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 460px;">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <SvgIcon Name="search" Size="16" Class="text-muted" />
                        </span>
                        <input type="text" 
                               class="form-control border-start-0" 
                               placeholder="Filtrar por nombre, apellido, usuario o correo @@bncenlinea.net..." 
                               @bind="tableSearch" 
                               @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(tableSearch))
                        {
                            <button class="btn btn-outline-secondary" type="button" @onclick="() => tableSearch = string.Empty">
                                <SvgIcon Name="dislike" Size="14" />
                            </button>
                        }
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" @onclick="ResetSampleDataAsync" title="Restaura la lista de los 51 participantes BNC">
                        <SvgIcon Name="refresh" Size="14" />
                        <span>Restablecer participantes BNC</span>
                    </button>
                    <span class="badge py-2 px-3 rounded-pill text-white" style="background-color: var(--bnc-navy);">
                        @FilteredPeople.Count participantes
                    </span>
                </div>
            </div>

            <!-- Mobile-First Cards View (Visible on Phones & Tablets < 992px) -->
            <div class="d-block d-lg-none p-2 p-sm-3 bg-light">
                @if (!FilteredPeople.Any())
                {
                    <div class="text-center py-4 text-muted bg-white rounded-3 border">
                        No se encontraron participantes que coincidan con la búsqueda.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var p in FilteredPeople)
                        {
                            <div class="bg-white p-3 rounded-3 border shadow-sm">
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                                        @if (p.HasProfilePhoto)
                                        {
                                            <img src="@p.ProfilePhotoPath" 
                                                 alt="@p.FullName" 
                                                 class="rounded-circle shadow-sm flex-shrink-0" 
                                                 style="width: 44px; height: 44px; object-fit: cover; border: 2px solid var(--bnc-orange);" />
                                        }
                                        else
                                        {
                                            <div class="avatar-circle flex-shrink-0" style="width: 44px; height: 44px; font-size: 0.95rem; background: linear-gradient(135deg, @(p.AvatarColor ?? "#002855"), var(--bnc-orange));">
                                                @p.Initials
                                            </div>
                                        }
                                        <div class="overflow-hidden">
                                            <div class="fw-bold text-dark text-truncate">@p.FullName</div>
                                            <small class="text-muted text-truncate d-block">@(p.Email ?? "Sin correo")</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- Credentials Pill on Mobile -->
                                <div class="d-flex flex-wrap align-items-center gap-2 p-2 rounded-2 bg-light border mb-2 small">
                                    <div>
                                        <span class="text-muted">Usuario:</span>
                                        <code class="fw-bold" style="color: var(--bnc-navy);">@p.Username</code>
                                    </div>
                                    <span class="text-muted">•</span>
                                    <div>
                                        <span class="text-muted">Clave:</span>
                                        <code class="fw-semibold" style="color: var(--bnc-orange);">@p.Password</code>
                                    </div>
                                </div>

                                <!-- Status Badges on Mobile -->
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @if (p.HasProfilePhoto)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Foto OK</span>
                                    }
                                    @if (p.HasGiftReference)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Regalo Ref</span>
                                    }
                                    @if (p.HasCustomLikes)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">@p.LikesList.Count gustos</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Gustos pendientes</span>
                                    }
                                </div>

                                <!-- Touch-Friendly Action Buttons -->
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1 py-2 d-flex align-items-center justify-content-center gap-1 fw-semibold" 
                                            style="border-color: var(--bnc-navy); color: var(--bnc-navy);"
                                            @onclick="() => OpenEditModal(p)">
                                        <SvgIcon Name="edit" Size="15" />
                                        <span>Editar / Clave</span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger px-3 py-2 d-flex align-items-center justify-content-center" 
                                            @onclick="() => ConfirmDelete(p)" 
                                            title="Eliminar participante">
                                        <SvgIcon Name="trash" Size="15" />
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Desktop Table View (Visible on >= 992px) -->
            <div class="table-responsive d-none d-lg-block">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4">Participante BNC</th>
                            <th>Acceso (Usuario / Clave)</th>
                            <th>Foto y Regalo</th>
                            <th>Gustos y Evitar</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!FilteredPeople.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    No se encontraron participantes que coincidan con la búsqueda.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in FilteredPeople)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (p.HasProfilePhoto)
                                            {
                                                <img src="@p.ProfilePhotoPath" 
                                                     alt="@p.FullName" 
                                                     class="rounded-circle shadow-sm flex-shrink-0" 
                                                     style="width: 44px; height: 44px; object-fit: cover; border: 2px solid var(--bnc-orange);" />
                                            }
                                            else
                                            {
                                                <div class="avatar-circle" style="width: 44px; height: 44px; font-size: 0.95rem; background: linear-gradient(135deg, @(p.AvatarColor ?? "#002855"), var(--bnc-orange));">
                                                    @p.Initials
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-bold text-dark">@p.FullName</div>
                                                <small class="text-muted">@(p.Email ?? "Sin correo")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1 small">
                                            <div>
                                                <span class="text-muted">Usuario:</span>
                                                <code class="fw-bold px-1 rounded bg-light border" style="color: var(--bnc-navy);">@p.Username</code>
                                            </div>
                                            <div>
                                                <span class="text-muted">Clave:</span>
                                                <code class="fw-semibold px-1 rounded bg-light border" style="color: var(--bnc-orange);">@p.Password</code>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (p.HasProfilePhoto)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                                    <SvgIcon Name="camera" Size="12" /> Foto OK
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Sin foto</span>
                                            }

                                            @if (p.HasGiftReference)
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center gap-1">
                                                    <SvgIcon Name="gift" Size="12" /> Regalo Ref
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1" style="max-width: 260px;">
                                            @if (p.HasCustomLikes)
                                            {
                                                <div class="badge bg-success-subtle text-success text-truncate text-start p-1 fw-normal border border-success-subtle d-flex align-items-center gap-1">
                                                    <SvgIcon Name="check" Size="12" />
                                                    <span class="text-truncate">@p.LikesList.Count gustos (@p.LikesList.First())</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">Gustos por cargar</span>
                                            }

                                            @if (p.HasCustomDislikes)
                                            {
                                                <div class="badge bg-danger-subtle text-danger text-truncate text-start p-1 fw-normal border border-danger-subtle d-flex align-items-center gap-1">
                                                    <SvgIcon Name="dislike" Size="12" />
                                                    <span class="text-truncate">@p.DislikesList.Count restricciones</span>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" 
                                                    style="border-color: var(--bnc-navy); color: var(--bnc-navy);"
                                                    @onclick="() => OpenEditModal(p)" 
                                                    title="Editar datos, usuario, contraseña, fotos y gustos">
                                                <SvgIcon Name="edit" Size="14" />
                                                <span>Editar / Clave</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center" 
                                                    @onclick="() => ConfirmDelete(p)" 
                                                    title="Eliminar participante">
                                                <SvgIcon Name="trash" Size="14" />
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Edit/Create Modal Component (Admin Mode = true) -->
        <PersonEditModal IsOpen="isEditModalOpen" 
                         IsAdminMode="true"
                         PersonToEdit="personToEdit" 
                         OnSaved="HandlePersonSaved" 
                         OnCancel="CloseEditModal" />

        <!-- Delete Confirmation Modal -->
        @if (personToDelete != null)
        {
            <div class="modal-backdrop-custom" @onclick="CancelDelete"></div>
            <div class="modal d-block" tabindex="-1" style="z-index: 1070;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                        <div class="modal-header border-bottom bg-danger-subtle text-danger px-4 py-3">
                            <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                                <SvgIcon Name="alert" Size="20" Class="text-danger" />
                                <span>Confirmar Eliminación</span>
                            </h5>
                            <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                        </div>
                        <div class="modal-body px-4 py-3">
                            <p class="mb-2">¿Estás seguro de que deseas eliminar a <strong>@personToDelete.FullName</strong> del Amigo Secreto BNC?</p>
                            <small class="text-muted">Se borrarán permanentemente sus preferencias de regalo, fotos y credenciales registradas.</small>
                        </div>
                        <div class="modal-footer border-top bg-light px-4 py-3">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Cancelar</button>
                            <button type="button" class="btn btn-danger px-4 d-flex align-items-center gap-2" @onclick="ExecuteDeleteAsync">
                                <SvgIcon Name="trash" Size="16" />
                                <span>Sí, Eliminar</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private string inputUser = "";
    private string inputPassword = "";
    private string? loginError;
    private bool showPassword = false;

    private List<Person> people = new();
    private string tableSearch = "";

    private bool isEditModalOpen = false;
    private Person? personToEdit;
    private Person? personToDelete;
    private string? statusMessage;

    private List<Person> FilteredPeople => string.IsNullOrWhiteSpace(tableSearch)
        ? people
        : people.Where(p => 
            p.FullName.Contains(tableSearch, StringComparison.OrdinalIgnoreCase) ||
            p.Username.Contains(tableSearch, StringComparison.OrdinalIgnoreCase) ||
            (p.Email != null && p.Email.Contains(tableSearch, StringComparison.OrdinalIgnoreCase))
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthenticationStateChanged += HandleAuthStateChanged;
        if (AuthService.IsAuthenticated)
        {
            await LoadDataAsync();
        }
        else
        {
            Navigation.NavigateTo("");
        }
    }

    private void HandleAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogin()
    {
        loginError = null;
        if (AuthService.Login(inputUser, inputPassword))
        {
            AuthService.LogoutParticipant();
            await LoadDataAsync();
            return;
        }

        var participant = await PersonService.AuthenticateParticipantAsync(inputUser, inputPassword);
        if (participant != null)
        {
            AuthService.Logout();
            AuthService.SetParticipant(participant);
            Navigation.NavigateTo("");
            return;
        }

        loginError = "Credenciales incorrectas.";
    }

    private void FillDemoCredentials()
    {
        inputUser = "admin";
        inputPassword = "bnc2026";
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        AuthService.LogoutParticipant();
        inputUser = "";
        inputPassword = "";
        Navigation.NavigateTo("");
    }

    private async Task LoadDataAsync()
    {
        people = await PersonService.GetAllAsync();
    }

    private void OpenCreateModal()
    {
        personToEdit = null;
        isEditModalOpen = true;
    }

    private void OpenEditModal(Person p)
    {
        personToEdit = p;
        isEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        personToEdit = null;
    }

    private async Task HandlePersonSaved(Person saved)
    {
        CloseEditModal();
        if (AuthService.CurrentParticipant?.Id == saved.Id)
        {
            AuthService.SetParticipant(saved);
        }
        await LoadDataAsync();
        ShowToast($"Participante '{saved.FullName}' (usuario: {saved.Username}) guardado exitosamente");
    }

    private void ConfirmDelete(Person p)
    {
        personToDelete = p;
    }

    private void CancelDelete()
    {
        personToDelete = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (personToDelete != null)
        {
            var name = personToDelete.FullName;
            await PersonService.DeleteAsync(personToDelete.Id);
            personToDelete = null;
            await LoadDataAsync();
            ShowToast($"'{name}' ha sido eliminado correctamente");
        }
    }

    private async Task ResetSampleDataAsync()
    {
        await PersonService.ResetSampleDataAsync();
        await LoadDataAsync();
        ShowToast("Participantes BNC y credenciales restaurados exitosamente");
    }

    private void ShowToast(string message)
    {
        statusMessage = message;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(3500);
            statusMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        AuthService.OnAuthenticationStateChanged -= HandleAuthStateChanged;
    }
}
