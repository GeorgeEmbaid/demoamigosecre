@inherits LayoutComponentBase
@implements IDisposable
@inject IAdminAuthService AuthService
@inject IThemeService ThemeService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="d-flex flex-column min-vh-100">
    <!-- Modern Top Navigation Bar -->
    <header class="modern-navbar py-2 px-2 px-sm-3 px-md-4">
        <div class="container-fluid d-flex align-items-center justify-content-between">
            <!-- Brand Logo -->
            <a href="" class="text-decoration-none d-flex align-items-center">
                <BncLogo Height="36" ShowSubtitle="true" />
            </a>

            <!-- Unified Session Navigation Controls -->
            <nav class="d-flex align-items-center gap-2">
                @if (AuthService.IsAuthenticated)
                {
                    <!-- Admin is logged in: can switch between Participant Directory and Admin Panel -->
                    <span class="d-none d-md-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill bg-success-subtle text-success border border-success-subtle small fw-semibold">
                        <SvgIcon Name="shield" Size="14" Class="text-success" />
                        <span>Administrador</span>
                    </span>

                    <NavLink href="" class="btn btn-sm btn-light px-2 px-sm-3 py-2 fw-semibold text-secondary d-flex align-items-center gap-1 border shadow-sm" Match="NavLinkMatch.All">
                        <SvgIcon Name="users" Size="15" Class="text-secondary" />
                        <span class="d-none d-sm-inline">Directorio</span>
                    </NavLink>

                    <NavLink href="admin" class="btn btn-sm px-2 px-sm-3 py-2 fw-semibold d-flex align-items-center gap-1 shadow-sm" style="border: 1px solid var(--bnc-navy); color: var(--bnc-navy); background: white;">
                        <SvgIcon Name="edit" Size="15" Class="text-primary" />
                        <span>Panel Admin</span>
                    </NavLink>

                    <button type="button" class="btn btn-sm btn-outline-danger px-2 px-sm-3 py-2 fw-semibold d-flex align-items-center gap-1 shadow-sm" @onclick="HandleUnifiedLogout" title="Cerrar sesión">
                        <SvgIcon Name="logout" Size="15" />
                        <span class="d-none d-sm-inline">Cerrar Sesión</span>
                    </button>
                }
                else if (AuthService.IsParticipantAuthenticated && AuthService.CurrentParticipant != null)
                {
                    <!-- Participant is logged in -->
                    <div class="d-flex align-items-center gap-2 px-2 px-sm-3 py-1 rounded-pill bg-light border">
                        @if (AuthService.CurrentParticipant.HasProfilePhoto)
                        {
                            <img src="@AuthService.CurrentParticipant.ProfilePhotoPath" 
                                 alt="@AuthService.CurrentParticipant.FullName" 
                                 class="rounded-circle" 
                                 style="width: 24px; height: 24px; object-fit: cover;" />
                        }
                        else
                        {
                            <SvgIcon Name="user" Size="14" Class="text-primary" />
                        }
                        <small class="fw-semibold text-dark text-truncate" style="max-width: 160px;">@AuthService.CurrentParticipant.FullName</small>
                    </div>

                    <button type="button" class="btn btn-sm btn-outline-danger px-2 px-sm-3 py-1 fw-semibold d-flex align-items-center gap-1 shadow-sm" @onclick="HandleUnifiedLogout" title="Cerrar sesión">
                        <SvgIcon Name="logout" Size="15" />
                        <span class="d-none d-sm-inline">Cerrar Sesión</span>
                    </button>
                }

                <!-- Dark / Light Mode Toggle Button -->
                <button type="button" 
                        class="theme-toggle-btn d-inline-flex align-items-center gap-1 gap-sm-2 px-2 px-sm-3 py-2 rounded-pill shadow-sm" 
                        @onclick="ToggleThemeAsync" 
                        title="@(ThemeService.IsDarkMode ? "Cambiar a modo claro" : "Cambiar a modo oscuro")"
                        aria-label="Cambiar tema">
                    <span class="theme-icon-box d-flex align-items-center justify-content-center">
                        @if (ThemeService.IsDarkMode)
                        {
                            <SvgIcon Name="sun" Size="16" Class="theme-icon-sun" />
                        }
                        else
                        {
                            <SvgIcon Name="moon" Size="16" Class="theme-icon-moon" />
                        }
                    </span>
                    <span class="d-none d-md-inline fw-semibold small theme-toggle-text">
                        @(ThemeService.IsDarkMode ? "Claro" : "Oscuro")
                    </span>
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Modern Clean Footer -->
    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container-fluid px-3 px-lg-5 d-flex flex-wrap align-items-center justify-content-between text-muted small">
            <div class="d-flex align-items-center gap-2 my-1">
                <strong style="color: var(--bnc-navy);">Amigo Secreto 2026</strong>
                <span>•</span>
                <span>Intercambio de Regalos</span>
            </div>
            <div class="d-flex align-items-center gap-3 my-1">
                <span class="d-inline-flex align-items-center gap-1">
                    <SvgIcon Name="gift" Size="14" Class="text-muted" /> Portal Amigo Secreto 2026
                </span>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar página</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthenticationStateChanged += HandleStateChanged;
        ThemeService.OnThemeChanged += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync(JS);
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeService.ToggleThemeAsync(JS);
    }

    private void HandleUnifiedLogout()
    {
        AuthService.Logout();
        AuthService.LogoutParticipant();
        Navigation.NavigateTo("", replace: true);
    }

    public void Dispose()
    {
        AuthService.OnAuthenticationStateChanged -= HandleStateChanged;
        ThemeService.OnThemeChanged -= HandleStateChanged;
    }
}
