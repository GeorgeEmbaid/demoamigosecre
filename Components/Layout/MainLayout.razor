@inherits LayoutComponentBase
@inject IAdminAuthService AuthService
@inject NavigationManager Navigation

<div class="d-flex flex-column min-vh-100">
    <!-- Modern Top Navigation Bar with Official BNC Branding -->
    <header class="modern-navbar py-2 px-2 px-sm-3 px-md-4">
        <div class="container-fluid d-flex align-items-center justify-content-between">
            <!-- BNC Official Logo & Amigo Secreto Portal Title -->
            <a href="" class="text-decoration-none d-flex align-items-center gap-2 gap-sm-3">
                <BncLogo Height="36" ShowSubtitle="true" />
                <div class="d-none d-md-block border-start ps-3" style="border-color: #cbd5e1 !important;">
                    <span class="fs-6 fw-bold d-block lh-1 text-dark">Portal Amigo Secreto</span>
                    <small class="text-muted fw-semibold" style="font-size: 0.72rem;">Edición Corporativa 2026</small>
                </div>
            </a>

            <!-- Nav Links with Clean Polished SVG Icons -->
            <nav class="d-flex align-items-center gap-1 gap-sm-2">
                <NavLink href="" class="btn btn-sm btn-light px-2 px-sm-3 py-2 fw-semibold text-secondary d-flex align-items-center gap-1 gap-sm-2 border shadow-sm" Match="NavLinkMatch.All">
                    <SvgIcon Name="search" Size="15" Class="text-secondary" />
                    <span class="d-none d-sm-inline">Buscar</span>
                </NavLink>

                <NavLink href="admin" class="btn btn-sm px-2 px-sm-3 py-2 fw-semibold d-flex align-items-center gap-1 gap-sm-2 shadow-sm" style="border: 1px solid var(--bnc-navy); color: var(--bnc-navy); background: white;">
                    <SvgIcon Name="shield" Size="15" Class="text-primary" />
                    @if (AuthService.IsAuthenticated)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Admin Activo</span>
                    }
                    else
                    {
                        <span>Admin</span>
                    }
                </NavLink>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Modern Clean Footer with BNC Accents -->
    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container-fluid px-3 px-lg-5 d-flex flex-wrap align-items-center justify-content-between text-muted small">
            <div class="d-flex align-items-center gap-2 my-1">
                <strong style="color: var(--bnc-navy);">BNC</strong>
                <span>•</span>
                <span>Banco Nacional de Crédito, C.A.</span>
                <span>•</span>
                <span>Amigo Secreto 2026</span>
            </div>
            <div class="d-flex align-items-center gap-3 my-1">
                <span class="d-inline-flex align-items-center gap-1">
                    <SvgIcon Name="lock" Size="14" Class="text-muted" /> Clave Admin: <code>bnc2026</code>
                </span>
                <span>•</span>
                <span class="text-muted">Blazor Server & SQLite</span>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar página</a>
    <span class="dismiss">🗙</span>
</div>
