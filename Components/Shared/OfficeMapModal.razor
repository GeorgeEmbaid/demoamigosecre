@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public List<Person> People { get; set; } = new();
    [Parameter] public EventCallback<Person> OnPersonSelected { get; set; }

    private string viewMode = "interactive"; // "interactive" or "original"
    private string searchName = string.Empty;
    private string selectedZone = "all"; // "all", "pb", "oeste", "meson", "filasur", "barrasur"
    private int zoomLevel = 85; // Default 85% as requested by user

    private Person? selectedCollaborator;
    private string selectedDeskZone = string.Empty;
    private string selectedDeskLocation = string.Empty;

    private void ZoomIn()
    {
        if (zoomLevel < 150) zoomLevel += 15;
    }

    private void ZoomOut()
    {
        if (zoomLevel > 45) zoomLevel -= 15;
    }

    private void ResetZoom()
    {
        zoomLevel = 85;
    }

    private void SetZone(string zone)
    {
        selectedZone = zone;
    }

    private void ResetFilters()
    {
        searchName = string.Empty;
        selectedZone = "all";
        zoomLevel = 85;
        selectedCollaborator = null;
    }

    private void ClearSearch()
    {
        searchName = string.Empty;
    }

    private void ClearSelection()
    {
        selectedCollaborator = null;
        selectedDeskLocation = string.Empty;
    }

    private async Task CloseAsync()
    {
        searchName = string.Empty;
        selectedCollaborator = null;
        zoomLevel = 85;
        await OnClose.InvokeAsync();
    }

    private void SelectDesk(string personName, string zone, string locationLabel)
    {
        var person = FindPerson(personName);
        if (person != null)
        {
            selectedCollaborator = person;
            selectedDeskZone = zone;
            selectedDeskLocation = locationLabel;
        }
    }

    private void SelectPersonFromSearch(Person person)
    {
        selectedCollaborator = person;
        selectedDeskLocation = GetLocationFor(person);
        // Switch to the zone where they sit
        if (LocationZoneMap.TryGetValue(person.FullName, out var zone))
        {
            selectedZone = zone;
        }
    }

    private async Task ViewPersonDetailAsync()
    {
        if (selectedCollaborator != null)
        {
            var p = selectedCollaborator;
            await OnPersonSelected.InvokeAsync(p);
            await CloseAsync();
        }
    }

    private Person? FindPerson(string fullName)
    {
        return People.FirstOrDefault(p => string.Equals(p.FullName, fullName, StringComparison.OrdinalIgnoreCase))
            ?? People.FirstOrDefault(p => p.FullName.Contains(fullName, StringComparison.OrdinalIgnoreCase) || fullName.Contains(p.FullName, StringComparison.OrdinalIgnoreCase));
    }

    private string FormatDisplayName(Person? person, string fallbackName)
    {
        if (person != null)
        {
            var first = person.FirstName.Trim();
            var last = person.LastName.Trim();
            if (first.Equals("Jose Manuel", StringComparison.OrdinalIgnoreCase))
            {
                return "Jose M. Q.";
            }
            if (first.Equals("Jose Luis", StringComparison.OrdinalIgnoreCase))
            {
                return "Jose L. R.";
            }
            var initial = !string.IsNullOrEmpty(last) ? $"{char.ToUpperInvariant(last[0])}." : "";
            return string.IsNullOrEmpty(initial) ? first : $"{first} {initial}";
        }

        var parts = fallbackName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            if (parts[0].Equals("Jose", StringComparison.OrdinalIgnoreCase) && parts.Length >= 3)
            {
                return $"{parts[0]} {char.ToUpperInvariant(parts[1][0])}. {char.ToUpperInvariant(parts[^1][0])}.";
            }
            return $"{parts[0]} {char.ToUpperInvariant(parts[^1][0])}.";
        }
        return fallbackName;
    }

    private bool IsMatched(string personName)
    {
        if (string.IsNullOrWhiteSpace(searchName)) return false;
        var q = searchName.Trim().ToLowerInvariant();
        var person = FindPerson(personName);
        if (person != null)
        {
            return person.FullName.ToLowerInvariant().Contains(q) ||
                   person.FirstName.ToLowerInvariant().Contains(q) ||
                   person.LastName.ToLowerInvariant().Contains(q);
        }
        return personName.ToLowerInvariant().Contains(q);
    }

    private bool IsActiveDesk(string personName)
    {
        if (selectedCollaborator == null) return false;
        return string.Equals(selectedCollaborator.FullName, personName, StringComparison.OrdinalIgnoreCase) ||
               selectedCollaborator.FullName.Contains(personName, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsDimmed(string zone, string personName)
    {
        // If a specific zone is selected, dim others
        if (selectedZone != "all" && !string.Equals(selectedZone, zone, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        // If search is active and this person doesn't match, dim it
        if (!string.IsNullOrWhiteSpace(searchName) && !IsMatched(personName))
        {
            return true;
        }

        return false;
    }

    private List<Person> MatchedParticipants
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchName)) return new List<Person>();
            var q = searchName.Trim().ToLowerInvariant();
            return People
                .Where(p => p.FullName.ToLowerInvariant().Contains(q) ||
                            p.FirstName.ToLowerInvariant().Contains(q) ||
                            p.LastName.ToLowerInvariant().Contains(q))
                .ToList();
        }
    }

