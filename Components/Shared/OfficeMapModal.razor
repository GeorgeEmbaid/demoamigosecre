    private string GetLocationFor(Person p)
    {
        if (LocationMap.TryGetValue(p.FullName, out var loc)) return loc;
        return "Piso 1 • Oficina";
    }

    private RenderFragment RenderDesk(string personName, string zone, string locationLabel, string? labelOverride = null)
    {
        var person = FindPerson(personName);
        var isMatched = IsMatched(personName);
        var isActive = IsActiveDesk(personName);
        var isDimmed = IsDimmed(zone, personName);
        var displayName = labelOverride ?? FormatDisplayName(person, personName);

        return @<div class="blueprint-desk @(isMatched ? "is-matched" : "") @(isActive ? "is-active" : "") @(isDimmed ? "is-dimmed" : "")"
                     @onclick="() => SelectDesk(personName, zone, locationLabel)"
                     title="@(person != null ? $"{person.FullName} • {locationLabel}" : personName)">
            @if (isMatched)
            {
                <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-danger shadow-sm" style="font-size: 0.62rem; z-index: 25; padding: 2px 6px;">
                    📍 Aquí
                </span>
            }

            <div class="blueprint-avatar" style="@(person != null && !string.IsNullOrEmpty(person.ProfilePhotoPath) ? "" : GetVibrantAvatarGradient(person))">
                @if (person != null && !string.IsNullOrEmpty(person.ProfilePhotoPath))
                {
                    <img src="@person.ProfilePhotoPath" alt="@displayName" />
                }
                else if (person != null)
                {
                    <span>@person.Initials</span>
                }
                else
                {
                    <SvgIcon Name="user" Size="13" />
                }
            </div>

            <div class="blueprint-desk-name">
                @displayName
            </div>

            @if (person != null && (person.HasCustomLikes || person.HasGiftReference))
            {
                <span class="ms-auto small" style="font-size: 0.68rem;" title="Tiene gustos o sugerencia de regalo cargada">
                    🎁
                </span>
            }
        </div>;
    }

    private string GetVibrantAvatarGradient(Person? person)
    {
        if (person == null)
        {
            return "background: linear-gradient(135deg, #0ea5e9, #0284c7);";
        }

        var color = person.AvatarColor?.Trim().ToUpperInvariant() ?? "#FF6600";
        return color switch
        {
            "#001933" => "background: linear-gradient(135deg, #ea580c, #FF6600);", // Bright festive orange
            "#002855" => "background: linear-gradient(135deg, #0284c7, #38bdf8);", // Bright sky/cyan
            "#475569" => "background: linear-gradient(135deg, #8b5cf6, #ec4899);", // Radiant violet/pink for Rosbel
            "#059669" => "background: linear-gradient(135deg, #10b981, #059669);", // Emerald green
            "#0D9488" => "background: linear-gradient(135deg, #14b8a6, #0d9488);", // Teal
            "#7C3AED" => "background: linear-gradient(135deg, #a855f7, #7c3aed);", // Purple
            "#DC2626" => "background: linear-gradient(135deg, #f43f5e, #dc2626);", // Rose red
            _ => $"background: linear-gradient(135deg, {color}, #FF6600);"
        };
    }

    private RenderFragment RenderGuestDesk(string name, string locationLabel) =>
        @<div class="blueprint-desk blueprint-desk-guest" 
              title="@name • @locationLabel (Puesto físico en oficina)">
            <div class="blueprint-avatar" style="background: linear-gradient(135deg, #818cf8, #6366f1);">
                <span>@(name.Length >= 2 ? name.Substring(0, 2).ToUpperInvariant() : "SO")</span>
            </div>
            <div class="blueprint-desk-name text-muted">
                @name
            </div>
            <span class="badge bg-secondary-subtle text-muted rounded-pill" style="font-size: 0.58rem; padding: 1px 4px;">
                Oficina
            </span>
        </div>;

    private RenderFragment RenderEmptyDesk(string label = "—") =>
        @<div class="blueprint-desk-empty">
            <small>@label</small>
        </div>;
}