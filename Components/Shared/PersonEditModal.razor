@inject IPersonService PersonService
@inject IImageStorageService ImageStorage

@if (IsOpen)
{
    <div class="modal-backdrop-custom" @onclick="HandleCancel"></div>
    <div class="bnc-modal-wrapper" tabindex="-1" role="dialog" aria-modal="true">
        <div class="bnc-modal-dialog">
            <EditForm Model="Model" OnValidSubmit="HandleValidSubmit" class="bnc-modal-content shadow-lg">
                <DataAnnotationsValidator />

                <!-- Sticky Modal Header -->
                <div class="bnc-modal-header bg-light border-bottom px-3 px-sm-4 py-3" style="border-top: 4px solid var(--bnc-orange);">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <div class="icon-box-sm rounded-circle text-white flex-shrink-0" style="background-color: var(--bnc-navy);">
                            <SvgIcon Name="@( !IsAdminMode ? "gift" : (IsNew ? "plus" : "edit") )" Size="16" />
                        </div>
                        <div class="overflow-hidden">
                            <h5 class="modal-title fw-bold mb-0 text-truncate" style="color: var(--bnc-navy-dark);">
                                @if (!IsAdminMode)
                                {
                                    <span>Mi Perfil, Gustos y Regalo Deseado</span>
                                }
                                else
                                {
                                    @(IsNew ? "Nuevo Participante BNC" : $"Editar: {Model.FullName}")
                                }
                            </h5>
                            @if (!IsAdminMode)
                            {
                                <small class="text-muted d-block text-truncate">Completa tus gustos y sube tu foto para tu Amigo Secreto</small>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close ms-2 flex-shrink-0" aria-label="Cerrar" @onclick="HandleCancel"></button>
                </div>

                <!-- Scrollable Modal Body -->
                <div class="bnc-modal-body px-3 px-sm-4 py-3">
                    @if (ErrorMessage != null)
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                            <SvgIcon Name="alert" Size="16" Class="text-danger flex-shrink-0" />
                            <div>@ErrorMessage</div>
                        </div>
                    }

                    @if (IsAdminMode)
                    {
                        <!-- Basic Information Row (Admin Mode - Mobile First) -->
                        <div class="row g-2 g-sm-3 mb-3">
                            <div class="col-12 col-sm-6 col-md-4">
                                <label class="form-label fw-semibold text-secondary small mb-1">Nombre *</label>
                                <InputText class="form-control" @bind-Value="Model.FirstName" @bind-Value:after="OnNameChangedByAdmin" placeholder="Ej: George" />
                                <ValidationMessage For="@(() => Model.FirstName)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-sm-6 col-md-4">
                                <label class="form-label fw-semibold text-secondary small mb-1">Apellido *</label>
                                <InputText class="form-control" @bind-Value="Model.LastName" @bind-Value:after="OnNameChangedByAdmin" placeholder="Ej: Embaid" />
                                <ValidationMessage For="@(() => Model.LastName)" class="text-danger small" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold text-secondary small mb-1">Correo Corporativo</label>
                                <InputText type="email" class="form-control" @bind-Value="Model.Email" placeholder="usuario@bncenlinea.net" />
                                <ValidationMessage For="@(() => Model.Email)" class="text-danger small" />
                            </div>
                        </div>

                        <!-- Credentials Section (Admin Only: Modify Username & Password) -->
                        <div class="p-3 mb-3 rounded-3 border" style="background-color: #f8fafc; border-color: #cbd5e1 !important;">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                <span class="fw-bold small d-flex align-items-center gap-1" style="color: var(--bnc-navy);">
                                    <SvgIcon Name="lock" Size="15" />
                                    <span>Credenciales de Acceso del Participante</span>
                                </span>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 small fw-semibold" style="color: var(--bnc-orange);" @onclick="GenerateDefaultCredentials">
                                    Autogenerar (inicial+apellido / apellido2026)
                                </button>
                            </div>
                            <div class="row g-2 g-sm-3">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label fw-semibold text-secondary small mb-1">Usuario de Acceso</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-muted">
                                            <SvgIcon Name="user" Size="15" />
                                        </span>
                                        <InputText class="form-control" @bind-Value="Model.Username" placeholder="Ej: gembaid" />
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label fw-semibold text-secondary small mb-1">Contraseña</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-muted">
                                            <SvgIcon Name="key" Size="15" />
                                        </span>
                                        <InputText class="form-control" @bind-Value="Model.Password" placeholder="Ej: embaid2026" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Photo & Gift Image Upload Section (Mobile First 1-col to 2-col) -->
                    <div class="row g-3 mb-3">
                        <!-- 1. Profile Photo Card -->
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-white h-100 d-flex flex-column justify-content-between shadow-sm">
                                <div>
                                    <label class="form-label fw-bold mb-1 d-flex align-items-center gap-2" style="color: var(--bnc-navy);">
                                        <SvgIcon Name="camera" Size="16" />
                                        <span>Foto de Perfil (Reconocimiento)</span>
                                    </label>
                                    <p class="text-muted small mb-2" style="font-size: 0.78rem;">
                                        Sube tu foto para que tu Amigo Secreto te reconozca fácilmente.
                                    </p>
                                </div>

                                <div class="d-flex align-items-center gap-3 my-1">
                                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
                                    {
                                        <img src="@Model.ProfilePhotoPath" 
                                             alt="Foto de perfil" 
                                             class="rounded-circle border shadow-sm" 
                                             style="width: 64px; height: 64px; object-fit: cover; flex-shrink: 0;" />
                                    }
                                    else
                                    {
                                        <div class="avatar-circle" style="width: 64px; height: 64px; font-size: 1.3rem; background: linear-gradient(135deg, @(Model.AvatarColor ?? "#002855"), var(--bnc-orange));">
                                            @Model.Initials
                                        </div>
                                    }

                                    <div class="flex-grow-1">
                                        <label class="btn btn-sm btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-1 py-2 mb-1" style="cursor: pointer; border-color: var(--bnc-navy); color: var(--bnc-navy);">
                                            <SvgIcon Name="upload" Size="14" />
                                            <span>@(isUploadingProfile ? "Subiendo..." : "Subir Foto")</span>
                                            <InputFile OnChange="HandleProfilePhotoUpload" accept="image/*" class="d-none" />
                                        </label>
                                        @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
                                        {
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 small w-100 text-decoration-none" @onclick="RemoveProfilePhotoAsync">
                                                Quitar foto
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Gift Image & Reference URL Card -->
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-white h-100 d-flex flex-column justify-content-between shadow-sm" style="border-color: var(--bnc-orange-border) !important; background-color: #fffaf5 !important;">
                                <div>
                                    <label class="form-label fw-bold mb-1 d-flex align-items-center gap-2" style="color: var(--bnc-orange);">
                                        <SvgIcon Name="image" Size="16" />
                                        <span>Regalo Deseado (Imagen y URL)</span>
                                    </label>
                                    <p class="text-muted small mb-2" style="font-size: 0.78rem;">
                                        Sube una imagen referencial del regalo que te gustaría recibir y su enlace.
                                    </p>
                                </div>

                                <div class="d-flex align-items-center gap-3 my-1">
                                    @if (!string.IsNullOrWhiteSpace(Model.GiftImagePath))
                                    {
                                        <img src="@Model.GiftImagePath" 
                                             alt="Imagen del regalo" 
                                             class="rounded-3 border shadow-sm" 
                                             style="width: 64px; height: 64px; object-fit: cover; flex-shrink: 0; background: white;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-3 border d-flex align-items-center justify-content-center bg-white text-muted" style="width: 64px; height: 64px; flex-shrink: 0;">
                                            <SvgIcon Name="gift" Size="26" Class="text-warning" />
                                        </div>
                                    }

                                    <div class="flex-grow-1">
                                        <label class="btn btn-sm btn-bnc-orange w-100 d-flex align-items-center justify-content-center gap-1 py-2 mb-1" style="cursor: pointer;">
                                            <SvgIcon Name="upload" Size="14" />
                                            <span>@(isUploadingGift ? "Subiendo..." : "Subir Imagen Regalo")</span>
                                            <InputFile OnChange="HandleGiftImageUpload" accept="image/*" class="d-none" />
                                        </label>
                                        @if (!string.IsNullOrWhiteSpace(Model.GiftImagePath))
                                        {
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 small w-100 text-decoration-none" @onclick="RemoveGiftImageAsync">
                                                Quitar imagen
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="mt-2">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white text-muted">
                                            <SvgIcon Name="link" Size="14" />
                                        </span>
                                        <InputText class="form-control" @bind-Value="Model.GiftReferenceUrl" placeholder="URL referencial (https://...)" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section: Cosas que le gustan -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-success mb-1 d-flex flex-wrap justify-content-between align-items-center gap-1">
                            <span class="d-flex align-items-center gap-1">
                                <SvgIcon Name="gift" Size="16" />
                                <span>Cosas que @(IsAdminMode ? "le gustan" : "me gustan") / Ideas de regalo</span>
                            </span>
                            <small class="text-muted fw-normal">Un gusto por línea</small>
                        </label>
                        <InputTextArea class="form-control border-success-subtle" 
                                       rows="3" 
                                       @bind-Value="Model.Likes" 
                                       placeholder="Ej: Café gourmet en grano, termo deportivo, chocolates oscuros, audífonos..." />
                    </div>

                    <!-- Section: Cosas que NO le gustan -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-danger mb-1 d-flex flex-wrap justify-content-between align-items-center gap-1">
                            <span class="d-flex align-items-center gap-1">
                                <SvgIcon Name="dislike" Size="16" />
                                <span>Cosas que NO @(IsAdminMode ? "le gustan" : "me gustan") / Evitar regalar</span>
                            </span>
                            <small class="text-muted fw-normal">Un ítem por línea</small>
                        </label>
                        <InputTextArea class="form-control border-danger-subtle" 
                                       rows="2" 
                                       @bind-Value="Model.Dislikes" 
                                       placeholder="Ej: Perfumes cítricos, adornos de cerámica, bebidas alcohólicas..." />
                    </div>

                    <!-- Section: Alergias -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-warning-emphasis mb-1 d-flex flex-wrap justify-content-between align-items-center gap-1">
                            <span class="d-flex align-items-center gap-1">
                                <SvgIcon Name="alert" Size="16" />
                                <span>A qué @(IsAdminMode ? "es alérgico" : "soy alérgico") / Restricciones médicas</span>
                            </span>
                            <small class="text-muted fw-normal">Alimenticias o de contacto</small>
                        </label>
                        <InputTextArea class="form-control border-warning-subtle" 
                                       rows="2" 
                                       @bind-Value="Model.Allergies" 
                                       placeholder="Ej: Alérgico al maní y frutos secos, intolerante a la lactosa..." />
                    </div>

                    <!-- Sizes & Favorite Color -->
                    <div class="row g-2 g-sm-3 mb-3 p-2 p-sm-3 bg-light rounded-3 border mx-0">
                        <div class="col-6 col-sm-4">
                            <label class="form-label fw-semibold text-secondary small mb-1 d-flex align-items-center gap-1">
                                <SvgIcon Name="shirt" Size="14" Class="text-muted" /> Talla Camisa
                            </label>
                            <InputText class="form-control form-control-sm" @bind-Value="Model.ShirtSize" placeholder="Ej: M, L, XL" />
                        </div>
                        <div class="col-6 col-sm-4">
                            <label class="form-label fw-semibold text-secondary small mb-1 d-flex align-items-center gap-1">
                                <SvgIcon Name="tag" Size="14" Class="text-muted" /> Calzado
                            </label>
                            <InputText class="form-control form-control-sm" @bind-Value="Model.ShoeSize" placeholder="Ej: 40, 42" />
                        </div>
                        <div class="col-12 col-sm-4">
                            <label class="form-label fw-semibold text-secondary small mb-1 d-flex align-items-center gap-1">
                                <SvgIcon Name="palette" Size="14" Class="text-muted" /> Color Favorito
                            </label>
                            <InputText class="form-control form-control-sm" @bind-Value="Model.FavoriteColor" placeholder="Ej: Azul Marino" />
                        </div>
                    </div>

                    <!-- Section: Notas Adicionales -->
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-secondary small mb-1">Notas extras / Mensaje para tu Amigo Secreto</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="Model.Notes" placeholder="Cualquier pista, talla de pantalón o comentario extra para tu amigo secreto..." />
                    </div>
                </div>

                <!-- Sticky Modal Footer -->
                <div class="bnc-modal-footer bg-light px-3 px-sm-4 py-3 border-top d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary px-3 flex-grow-1 flex-sm-grow-0" @onclick="HandleCancel">Cancelar</button>
                    <button type="submit" class="btn btn-bnc-orange px-4 d-flex align-items-center justify-content-center gap-2 flex-grow-1 flex-sm-grow-0" disabled="@(isSaving || isUploadingProfile || isUploadingGift)">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <SvgIcon Name="check" Size="16" />
                            <span>@(IsAdminMode ? "Guardar Participante" : "Guardar Mis Preferencias")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsAdminMode { get; set; } = true;
    [Parameter] public Person? PersonToEdit { get; set; }
    [Parameter] public EventCallback<Person> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Person Model = new();
    private bool IsNew => PersonToEdit == null || PersonToEdit.Id == 0;
    private bool isSaving = false;
    private bool isUploadingProfile = false;
    private bool isUploadingGift = false;
    private string? ErrorMessage;

    private static readonly string[] ColorPalette = new[]
    {
        "#002855", // BNC Navy
        "#FF6600", // BNC Orange
        "#059669", // Emerald
        "#7C3AED", // Purple
        "#0D9488", // Teal
        "#DC2626", // Red
        "#475569", // Slate
        "#001933"  // Deep Night
    };

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            ErrorMessage = null;
            if (PersonToEdit != null && PersonToEdit.Id != 0)
            {
                // Si aún tiene el texto por defecto "Pendiente por definir", mostrar el campo vacío para facilitar la edición
                var likes = PersonToEdit.HasCustomLikes ? PersonToEdit.Likes : "";
                var dislikes = PersonToEdit.HasCustomDislikes ? PersonToEdit.Dislikes : "";

                Model = new Person
                {
                    Id = PersonToEdit.Id,
                    FirstName = PersonToEdit.FirstName,
                    LastName = PersonToEdit.LastName,
                    Username = PersonToEdit.Username,
                    Password = PersonToEdit.Password,
                    Email = PersonToEdit.Email,
                    ShirtSize = PersonToEdit.ShirtSize,
                    ShoeSize = PersonToEdit.ShoeSize,
                    FavoriteColor = PersonToEdit.FavoriteColor,
                    AvatarColor = PersonToEdit.AvatarColor ?? "#002855",
                    ProfilePhotoPath = PersonToEdit.ProfilePhotoPath,
                    GiftImagePath = PersonToEdit.GiftImagePath,
                    GiftReferenceUrl = PersonToEdit.GiftReferenceUrl,
                    Likes = likes,
                    Dislikes = dislikes,
                    Allergies = PersonToEdit.Allergies,
                    Notes = PersonToEdit.Notes,
                    CreatedAt = PersonToEdit.CreatedAt
                };
            }
            else
            {
                Model = new Person
                {
                    AvatarColor = ColorPalette[0],
                    Likes = "",
                    Dislikes = "",
                    Allergies = ""
                };
            }
        }
    }

    private void OnNameChangedByAdmin()
    {
        if (IsNew && !string.IsNullOrWhiteSpace(Model.FirstName) && !string.IsNullOrWhiteSpace(Model.LastName))
        {
            GenerateDefaultCredentials();
        }
    }

    private void GenerateDefaultCredentials()
    {
        if (!string.IsNullOrWhiteSpace(Model.FirstName) && !string.IsNullOrWhiteSpace(Model.LastName))
        {
            Model.Username = Person.GenerateDefaultUsername(Model.FirstName, Model.LastName);
            Model.Password = Person.GenerateDefaultPassword(Model.LastName);
            Model.Email = Person.GenerateDefaultEmail(Model.FirstName, Model.LastName);
        }
    }

    private async Task HandleProfilePhotoUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isUploadingProfile = true;
        ErrorMessage = null;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            Model.ProfilePhotoPath = await ImageStorage.SaveProfilePhotoAsync(
                Model.FirstName,
                Model.LastName,
                ms.ToArray(),
                file.ContentType);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No se pudo cargar la foto de perfil: {ex.Message}";
        }
        finally
        {
            isUploadingProfile = false;
        }
    }

    private async Task HandleGiftImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isUploadingGift = true;
        ErrorMessage = null;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            Model.GiftImagePath = await ImageStorage.SaveGiftImageAsync(
                Model.FirstName,
                Model.LastName,
                ms.ToArray(),
                file.ContentType);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No se pudo cargar la imagen del regalo: {ex.Message}";
        }
        finally
        {
            isUploadingGift = false;
        }
    }

    private async Task RemoveProfilePhotoAsync()
    {
        Model.ProfilePhotoPath = null;
        await ImageStorage.RemoveProfilePhotoAsync(Model.FirstName, Model.LastName);
    }

    private async Task RemoveGiftImageAsync()
    {
        Model.GiftImagePath = null;
        await ImageStorage.RemoveGiftImageAsync(Model.FirstName, Model.LastName);
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        ErrorMessage = null;

        try
        {
            Person saved;
            if (IsNew)
            {
                saved = await PersonService.CreateAsync(Model);
            }
            else
            {
                saved = await PersonService.UpdateAsync(Model);
            }

            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }
}
