@inject IPersonService PersonService
@inject IImageStorageService ImageStorage

@if (IsOpen)
{
    <div class="modal-backdrop-custom" @onclick="HandleCancel"></div>
    <div class="bnc-modal-wrapper" tabindex="-1" role="dialog" aria-modal="true">
        <div class="bnc-modal-dialog">
            <EditForm Model="Model" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" class="bnc-modal-content shadow-lg">
                <DataAnnotationsValidator />

                <!-- Sticky Modal Header -->
                <div class="bnc-modal-header bg-light border-bottom px-3 px-sm-4 py-3" style="border-top: 4px solid var(--bnc-orange);">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <div class="icon-box-sm rounded-circle text-white flex-shrink-0" style="background-color: var(--bnc-navy);">
                            <SvgIcon Name="@( !IsAdminMode ? "gift" : (IsNew ? "plus" : "edit") )" Size="16" />
                        </div>
                        <div class="overflow-hidden">
                            <h5 class="modal-title fw-bold mb-0 text-truncate" style="color: var(--bnc-navy-dark);">
                                @if (!IsAdminMode)
                                {
                                    <span>Mi Perfil, Gustos y Propuestas de Regalo</span>
                                }
                                else
                                {
                                    @(IsNew ? "Nuevo Participante BNC" : $"Editar: {Model.FullName}")
                                }
                            </h5>
                            @if (!IsAdminMode)
                            {
                                <small class="text-muted d-block text-truncate">Navega por las pestañas para completar tu perfil, tus gustos y tus propuestas de regalo</small>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn-close ms-2 flex-shrink-0" aria-label="Cerrar" @onclick="HandleCancel"></button>
                </div>

                <!-- 3-Tabs Navigation Bar -->
                <div class="bnc-tabs-bar" role="tablist">
                    <button type="button"
                            role="tab"
                            aria-selected="@(activeTab == 1)"
                            class="bnc-tab-btn @(activeTab == 1 ? "active" : "")"
                            @onclick="() => activeTab = 1">
                        <span class="bnc-tab-icon d-inline-flex">
                            <SvgIcon Name="user" Size="16" />
                        </span>
                        <span>1. Perfil</span>
                    </button>

                    <button type="button"
                            role="tab"
                            aria-selected="@(activeTab == 2)"
                            class="bnc-tab-btn @(activeTab == 2 ? "active" : "")"
                            @onclick="() => activeTab = 2">
                        <span class="bnc-tab-icon d-inline-flex">
                            <SvgIcon Name="heart" Size="16" />
                        </span>
                        <span>2. Gustos</span>
                    </button>

                    <button type="button"
                            role="tab"
                            aria-selected="@(activeTab == 3)"
                            class="bnc-tab-btn @(activeTab == 3 ? "active" : "")"
                            @onclick="() => activeTab = 3">
                        <span class="bnc-tab-icon d-inline-flex">
                            <SvgIcon Name="gift" Size="16" />
                        </span>
                        <span>3. Regalo Deseado</span>
                        @if (GiftProposals.Count(p => p.HasContent) > 0)
                        {
                            <span class="badge rounded-pill text-white ms-1" style="background-color: var(--bnc-orange); font-size: 0.7rem;">
                                @GiftProposals.Count(p => p.HasContent)
                            </span>
                        }
                    </button>
                </div>

                <!-- Scrollable Modal Body -->
                <div class="bnc-modal-body px-3 px-sm-4 py-3">
                    @if (ErrorMessage != null)
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                            <SvgIcon Name="alert" Size="16" Class="text-danger flex-shrink-0" />
                            <div>@ErrorMessage</div>
                        </div>
                    }

                    @if (activeTab == 1)
                    {
                        <!-- TAB 1: PERFIL -->
                        @if (IsAdminMode)
                        {
                            <!-- Basic Information Row (Admin Mode - Mobile First) -->
                            <div class="row g-2 g-sm-3 mb-3">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label fw-semibold text-secondary small mb-1">Nombre *</label>
                                    <InputText class="form-control" @bind-Value="Model.FirstName" @bind-Value:after="OnNameChangedByAdmin" />
                                    <ValidationMessage For="@(() => Model.FirstName)" class="text-danger small" />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label fw-semibold text-secondary small mb-1">Apellido *</label>
                                    <InputText class="form-control" @bind-Value="Model.LastName" @bind-Value:after="OnNameChangedByAdmin" />
                                    <ValidationMessage For="@(() => Model.LastName)" class="text-danger small" />
                                </div>
                            </div>

                            <!-- Credentials Section (Admin Only: Modify Username & Password) -->
                            <div class="p-3 mb-3 rounded-3 border" style="background-color: #f8fafc; border-color: #cbd5e1 !important;">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                    <span class="fw-bold small d-flex align-items-center gap-1" style="color: var(--bnc-navy);">
                                        <SvgIcon Name="lock" Size="15" />
                                        <span>Credenciales de Acceso del Participante</span>
                                    </span>
                                </div>
                                <div class="row g-2 g-sm-3">
                                    <div class="col-12 col-sm-6">
                                        <label class="form-label fw-semibold text-secondary small mb-1">Usuario de Acceso</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white text-muted">
                                                <SvgIcon Name="user" Size="15" />
                                            </span>
                                            <InputText class="form-control" @bind-Value="Model.Username" />
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <label class="form-label fw-semibold text-secondary small mb-1">Contraseña</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white text-muted">
                                                <SvgIcon Name="key" Size="15" />
                                            </span>
                                            <InputText class="form-control" @bind-Value="Model.Password" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Foto de Perfil Card -->
                        <div class="p-3 rounded-3 border bg-white mb-3 shadow-sm">
                            <label class="form-label fw-bold mb-2 d-flex align-items-center gap-2" style="color: var(--bnc-navy);">
                                <SvgIcon Name="camera" Size="16" />
                                <span>Foto de Perfil</span>
                            </label>

                            <div class="d-flex flex-wrap flex-sm-nowrap align-items-center gap-3 my-1">
                                @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
                                {
                                    <img src="@Model.ProfilePhotoPath" 
                                         alt="Foto de perfil" 
                                         class="rounded-circle border shadow-sm" 
                                         style="width: 72px; height: 72px; object-fit: cover; flex-shrink: 0;" />
                                }
                                else
                                {
                                    <div class="avatar-circle" style="width: 72px; height: 72px; font-size: 1.4rem; background: linear-gradient(135deg, @(Model.AvatarColor ?? "#002855"), var(--bnc-orange));">
                                        @Model.Initials
                                    </div>
                                }

                                <div class="flex-grow-1">
                                    <label class="btn btn-sm btn-outline-primary d-inline-flex align-items-center justify-content-center gap-2 px-3 py-2 mb-1" style="cursor: pointer; border-color: var(--bnc-navy); color: var(--bnc-navy);">
                                        <SvgIcon Name="upload" Size="14" />
                                        <span>@(isUploadingProfile ? "Subiendo..." : "Subir Foto de Perfil")</span>
                                        <InputFile OnChange="HandleProfilePhotoUpload" accept="image/*" class="d-none" />
                                    </label>
                                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
                                    {
                                        <div class="mt-1">
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 small text-decoration-none" @onclick="RemoveProfilePhotoAsync">
                                                Quitar foto
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Sizes & Favorite Color -->
                        <div class="row g-2 g-sm-3 mb-3 p-2 p-sm-3 bg-light rounded-3 border mx-0">
                            <div class="col-6 col-sm-4">
                                <label class="form-label fw-semibold text-secondary small mb-1 d-flex align-items-center gap-1">
                                    <SvgIcon Name="shirt" Size="14" Class="text-muted" /> Talla Camisa
                                </label>
                                <InputText class="form-control form-control-sm" @bind-Value="Model.ShirtSize" />
                            </div>
                            <div class="col-6 col-sm-4">
                                <label class="form-label fw-semibold text-secondary small mb-1 d-flex align-items-center gap-1">
                                    <SvgIcon Name="tag" Size="14" Class="text-muted" /> Calzado
                                </label>
                                <InputText class="form-control form-control-sm" @bind-Value="Model.ShoeSize" />
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label fw-semibold text-secondary small mb-1 d-flex align-items-center gap-1">
                                    <SvgIcon Name="palette" Size="14" Class="text-muted" /> Color Favorito
                                </label>
                                <InputText class="form-control form-control-sm" @bind-Value="Model.FavoriteColor" />
                            </div>
                        </div>

                        <!-- Section: Notas Adicionales -->
                        <div class="mb-2">
                            <label class="form-label fw-semibold text-secondary small mb-1">Notas extras / Mensaje para tu Amigo Secreto</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="Model.Notes" />
                        </div>
                    }
                    else if (activeTab == 2)
                    {
                        <!-- TAB 2: GUSTOS Y ALERGIAS -->
                        <!-- Section: Cosas que le gustan -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-success mb-1 d-flex align-items-center gap-1">
                                <SvgIcon Name="gift" Size="16" />
                                <span>Cosas que @(IsAdminMode ? "le gustan" : "me gustan")</span>
                            </label>
                            <InputTextArea class="form-control border-success-subtle" 
                                           rows="4" 
                                           @bind-Value="Model.Likes" />
                        </div>

                        <!-- Section: Cosas que NO le gustan -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-danger mb-1 d-flex align-items-center gap-1">
                                <SvgIcon Name="dislike" Size="16" />
                                <span>Cosas que NO @(IsAdminMode ? "le gustan" : "me gustan")</span>
                            </label>
                            <InputTextArea class="form-control border-danger-subtle" 
                                           rows="3" 
                                           @bind-Value="Model.Dislikes" />
                        </div>

                        <!-- Section: Alergias -->
                        <div class="mb-2">
                            <label class="form-label fw-bold text-warning-emphasis mb-1 d-flex align-items-center gap-1">
                                <SvgIcon Name="alert" Size="16" />
                                <span>A qué @(IsAdminMode ? "es alérgico" : "soy alérgico")</span>
                            </label>
                            <InputTextArea class="form-control border-warning-subtle" 
                                           rows="2" 
                                           @bind-Value="Model.Allergies" />
                        </div>
                    }
                    else if (activeTab == 3)
                    {
                        <!-- TAB 3: PROPUESTAS DE REGALO DESEADO -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <div>
                                <h6 class="fw-bold mb-0 d-flex align-items-center gap-2" style="color: var(--bnc-navy-dark);">
                                    <SvgIcon Name="gift" Size="17" Class="text-warning" />
                                    <span>Propuestas de Regalo Deseado</span>
                                </h6>
                                <small class="text-muted">Puedes agregar una o varias opciones de regalo con su descripción, enlace e imagen.</small>
                            </div>
                            <button type="button"
                                    class="btn btn-sm btn-bnc-orange d-inline-flex align-items-center gap-1 px-3 py-2"
                                    @onclick="AddGiftProposal">
                                <SvgIcon Name="plus" Size="14" />
                                <span>Agregar Propuesta</span>
                            </button>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @for (int i = 0; i < GiftProposals.Count; i++)
                            {
                                var index = i;
                                var proposal = GiftProposals[index];
                                var isUploadingThis = uploadingProposalId == proposal.Id;

                                <div class="gift-proposal-card shadow-sm" @key="proposal.Id">
                                    <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom" style="border-color: #fed7aa !important;">
                                        <span class="badge text-white d-inline-flex align-items-center gap-1 px-2 py-1" style="background-color: var(--bnc-orange);">
                                            <SvgIcon Name="gift" Size="12" />
                                            <span>Propuesta #@(index + 1)</span>
                                        </span>

                                        @if (GiftProposals.Count > 1 || proposal.HasContent)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger py-0 px-2 d-inline-flex align-items-center gap-1 small"
                                                    @onclick="() => RemoveGiftProposalAsync(proposal)">
                                                <SvgIcon Name="trash" Size="13" />
                                                <span>Eliminar</span>
                                            </button>
                                        }
                                    </div>

                                    <div class="row g-3 align-items-center">
                                        <!-- Imagen del artículo -->
                                        <div class="col-12 col-sm-5">
                                            <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-white border">
                                                @if (!string.IsNullOrWhiteSpace(proposal.ImagePath))
                                                {
                                                    <img src="@proposal.ImagePath"
                                                         alt="Imagen propuesta @(index + 1)"
                                                         class="rounded-2 border shadow-sm"
                                                         style="width: 68px; height: 68px; object-fit: cover; flex-shrink: 0; background: white;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-2 border d-flex align-items-center justify-content-center bg-light text-muted"
                                                         style="width: 68px; height: 68px; flex-shrink: 0;">
                                                        <SvgIcon Name="image" Size="24" Class="text-warning" />
                                                    </div>
                                                }

                                                <div class="flex-grow-1 overflow-hidden">
                                                    <label class="btn btn-sm btn-bnc-orange w-100 d-flex align-items-center justify-content-center gap-1 py-2 mb-1" style="cursor: pointer;">
                                                        <SvgIcon Name="upload" Size="14" />
                                                        <span class="text-truncate">@(isUploadingThis ? "Subiendo..." : "Subir Imagen")</span>
                                                        <InputFile OnChange="@(e => HandleProposalImageUpload(proposal, e))" accept="image/*" class="d-none" />
                                                    </label>
                                                    @if (!string.IsNullOrWhiteSpace(proposal.ImagePath))
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-link text-danger p-0 small w-100 text-decoration-none"
                                                                @onclick="() => RemoveProposalImageAsync(proposal)">
                                                            Quitar imagen
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Breve descripción y URL referencial -->
                                        <div class="col-12 col-sm-7">
                                            <div class="mb-2">
                                                <label class="form-label fw-semibold text-secondary small mb-1">Breve descripción del artículo</label>
                                                <input type="text"
                                                       class="form-control form-control-sm bg-white"
                                                       @bind="proposal.Description"
                                                       @bind:event="oninput" />
                                            </div>
                                            <div>
                                                <label class="form-label fw-semibold text-secondary small mb-1">URL referencial</label>
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text bg-white text-muted">
                                                        <SvgIcon Name="link" Size="14" />
                                                    </span>
                                                    <input type="text"
                                                           class="form-control bg-white"
                                                           @bind="proposal.ReferenceUrl"
                                                           @bind:event="oninput" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Sticky Modal Footer -->
                <div class="bnc-modal-footer bg-light px-3 px-sm-4 py-3 border-top d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary px-3 flex-grow-1 flex-sm-grow-0" @onclick="HandleCancel">Cancelar</button>
                    <button type="submit" class="btn btn-bnc-orange px-4 d-flex align-items-center justify-content-center gap-2 flex-grow-1 flex-sm-grow-0" disabled="@(isSaving || isUploadingProfile || uploadingProposalId != null)">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <SvgIcon Name="check" Size="16" />
                            <span>@(IsAdminMode ? "Guardar Participante" : "Guardar Mis Preferencias")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsAdminMode { get; set; } = true;
    [Parameter] public Person? PersonToEdit { get; set; }
    [Parameter] public EventCallback<Person> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Person Model = new();
    private List<GiftProposal> GiftProposals = new();
    private int activeTab = 1;
    private bool _wasOpen = false;
    private int? _loadedPersonId = null;

    private bool IsNew => PersonToEdit == null || PersonToEdit.Id == 0;
    private bool isSaving = false;
    private bool isUploadingProfile = false;
    private string? uploadingProposalId = null;
    private string? ErrorMessage;

    private static readonly string[] ColorPalette = new[]
    {
        "#002855", // BNC Navy
        "#FF6600", // BNC Orange
        "#059669", // Emerald
        "#7C3AED", // Purple
        "#0D9488", // Teal
        "#DC2626", // Red
        "#475569", // Slate
        "#001933"  // Deep Night
    };

    protected override void OnParametersSet()
    {
        if (IsOpen && (!_wasOpen || _loadedPersonId != PersonToEdit?.Id))
        {
            _wasOpen = true;
            _loadedPersonId = PersonToEdit?.Id;
            activeTab = 1;
            ErrorMessage = null;

            if (PersonToEdit != null && PersonToEdit.Id != 0)
            {
                var likes = PersonToEdit.HasCustomLikes ? PersonToEdit.Likes : "";
                var dislikes = PersonToEdit.HasCustomDislikes ? PersonToEdit.Dislikes : "";

                Model = new Person
                {
                    Id = PersonToEdit.Id,
                    FirstName = PersonToEdit.FirstName,
                    LastName = PersonToEdit.LastName,
                    Username = PersonToEdit.Username,
                    Password = PersonToEdit.Password,
                    Email = PersonToEdit.Email,
                    ShirtSize = PersonToEdit.ShirtSize,
                    ShoeSize = PersonToEdit.ShoeSize,
                    FavoriteColor = PersonToEdit.FavoriteColor,
                    AvatarColor = PersonToEdit.AvatarColor ?? "#002855",
                    ProfilePhotoPath = PersonToEdit.ProfilePhotoPath,
                    GiftImagePath = PersonToEdit.GiftImagePath,
                    GiftReferenceUrl = PersonToEdit.GiftReferenceUrl,
                    Likes = likes,
                    Dislikes = dislikes,
                    Allergies = PersonToEdit.Allergies,
                    Notes = PersonToEdit.Notes,
                    CreatedAt = PersonToEdit.CreatedAt
                };

                GiftProposals = Model.GetGiftProposals()
                    .Select(p => new GiftProposal
                    {
                        Id = p.Id,
                        Description = p.Description,
                        ReferenceUrl = p.ReferenceUrl,
                        ImagePath = p.ImagePath
                    })
                    .ToList();
            }
            else
            {
                Model = new Person
                {
                    AvatarColor = ColorPalette[0],
                    Likes = "",
                    Dislikes = "",
                    Allergies = ""
                };
                GiftProposals = new List<GiftProposal>();
            }

            if (GiftProposals.Count == 0)
            {
                GiftProposals.Add(new GiftProposal());
            }
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
            _loadedPersonId = null;
        }
    }

    private void OnNameChangedByAdmin()
    {
        if (IsNew && !string.IsNullOrWhiteSpace(Model.FirstName) && !string.IsNullOrWhiteSpace(Model.LastName))
        {
            GenerateDefaultCredentials();
        }
    }

    private void GenerateDefaultCredentials()
    {
        if (!string.IsNullOrWhiteSpace(Model.FirstName) && !string.IsNullOrWhiteSpace(Model.LastName))
        {
            Model.Username = Person.GenerateDefaultUsername(Model.FirstName, Model.LastName);
            Model.Password = Person.GenerateDefaultPassword(Model.LastName);
            Model.Email = Person.GenerateDefaultEmail(Model.FirstName, Model.LastName);
        }
    }

    private void AddGiftProposal()
    {
        GiftProposals.Add(new GiftProposal());
    }

    private async Task RemoveGiftProposalAsync(GiftProposal proposal)
    {
        if (!string.IsNullOrWhiteSpace(proposal.ImagePath))
        {
            await ImageStorage.RemoveGiftProposalImageAsync(Model.FirstName, Model.LastName, proposal.Id);
        }

        GiftProposals.Remove(proposal);
        if (GiftProposals.Count == 0)
        {
            GiftProposals.Add(new GiftProposal());
        }
    }

    private async Task HandleProfilePhotoUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isUploadingProfile = true;
        ErrorMessage = null;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            Model.ProfilePhotoPath = await ImageStorage.SaveProfilePhotoAsync(
                Model.FirstName,
                Model.LastName,
                ms.ToArray(),
                file.ContentType);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No se pudo cargar la foto de perfil: {ex.Message}";
        }
        finally
        {
            isUploadingProfile = false;
        }
    }

    private async Task HandleProposalImageUpload(GiftProposal proposal, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        uploadingProposalId = proposal.Id;
        ErrorMessage = null;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            proposal.ImagePath = await ImageStorage.SaveGiftProposalImageAsync(
                Model.FirstName,
                Model.LastName,
                proposal.Id,
                ms.ToArray(),
                file.ContentType);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"No se pudo cargar la imagen del regalo: {ex.Message}";
        }
        finally
        {
            uploadingProposalId = null;
        }
    }

    private async Task RemoveProfilePhotoAsync()
    {
        Model.ProfilePhotoPath = null;
        await ImageStorage.RemoveProfilePhotoAsync(Model.FirstName, Model.LastName);
    }

    private async Task RemoveProposalImageAsync(GiftProposal proposal)
    {
        proposal.ImagePath = null;
        await ImageStorage.RemoveGiftProposalImageAsync(Model.FirstName, Model.LastName, proposal.Id);
    }

    private void HandleInvalidSubmit()
    {
        activeTab = 1;
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        ErrorMessage = null;

        try
        {
            Model.SetGiftProposals(GiftProposals);

            Person saved;
            if (IsNew)
            {
                saved = await PersonService.CreateAsync(Model);
            }
            else
            {
                saved = await PersonService.UpdateAsync(Model);
            }

            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }
}
